# =================================================================
# SMART MESS – HOSTEL MESS MANAGEMENT PORTAL
# Backend Environment Configuration Template
# =================================================================

# Server Port
PORT=5000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas Cluster)
# Local: mongodb://127.0.0.1:27017/smart_mess
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_mess?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_mess

# JSON Web Token Secret Key (Use a strong 64-char random hex string in production)
JWT_SECRET=smart_mess_jwt_super_secret_key_2026_production

# Razorpay Payment Gateway Credentials (Test or Live)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_SmartMess2026Key
RAZORPAY_KEY_SECRET=smartMessSecretKey9928347
RAZORPAY_WEBHOOK_SECRET=smartMessWebhookSecret2026

# Optional: Cloudinary Storage for High-Volume Media
CLOUDINARY_CLOUD_NAME=smartmess_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=smartmess_cloud_secret

# Optional: SMTP Email Notification Credentials (Nodemailer)
# If omitted or left as simulation, emails are logged to server console in dev mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=messoffice@hostel.edu
SMTP_PASS=app_password_here
FROM_EMAIL=no-reply@smartmess.edu
FROM_NAME="Smart Mess Automated Portal"
